# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env.local` for local dev, or provide these
# as build args / platform env vars when deploying.
#
# NOTE: the API client appends `/api/v1` automatically, so give the bare host.
#   e.g. NEXT_PUBLIC_API_BASE_URL=https://api.pahariyatri.com
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing /api/v1)
# Production builds default to the live API via .env.production
# (https://api.pahariyatri.com).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Active authentication mode.
#   pin — phone number + PIN only (current testing phase; OTP screens dormant)
#   otp — OTP verification for registration/recovery (needs a real OTP provider)
NEXT_PUBLIC_AUTH_MODE=pin

# Razorpay public key (client-side checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Analytics / monitoring (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ---------------------------------------------------------------------------
# Customer support channels (PY-004)
#
# These drive every contact affordance on the site: footer, trip builder,
# vendor profile, trip review, booking-request screen and checkout. Each one
# renders ONLY when the corresponding value is set — leave a value blank and
# that channel simply doesn't appear. Never put a placeholder number here: a
# fake-looking support number is worse than no number.
#
# NEXT_PUBLIC_SUPPORT_WHATSAPP also gates the "24/7 On-Trip Support" line in
# the trip builder's "Our Promise" card (together with _PHONE) — the claim is
# hidden until a real live channel exists to back it.
# ---------------------------------------------------------------------------

# Full international WhatsApp number, digits only, no "+" (e.g. 919876543210)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Dialable support phone number (e.g. +91 98765 43210)
NEXT_PUBLIC_SUPPORT_PHONE=

# Support mailbox. Defaults to support@pahariyatri.com when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Human-readable staffed hours shown next to the channels (e.g. "9am-9pm IST").
# Leave blank unless the hours are genuinely staffed.
NEXT_PUBLIC_SUPPORT_HOURS=
